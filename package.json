{
  "name": "findandfill",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:mutation": "pnpm -r test:mutation",
    "verifier": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage",
    "generer:jeu": "pnpm --filter @findandfill/jeu-synthetique generer",
    "test:e2e": "pnpm --filter @findandfill/desktop test:e2e",
    "dev": "pnpm --filter @findandfill/desktop dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
